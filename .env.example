# The Agentcity Town Chest. Copy to .env (never committed) and fill in.
# forge reads this file automatically when run from the repository root.

# --- Network: Robinhood Chain ----------------------------------------------------
# JSON-RPC endpoint (used as --rpc-url deploy).
#   testnet  https://rpc.testnet.chain.robinhood.com   chain id 46630
#   mainnet  https://rpc.mainnet.chain.robinhood.com   chain id 4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Blockscout explorer API, for --verify. No API key is needed.
#   testnet  https://explorer.testnet.chain.robinhood.com/api/
#   mainnet  https://robinhoodchain.blockscout.com/api/
VERIFIER_URL=https://robinhoodchain.blockscout.com/api/
# The deployer. Leave empty to sign with --account (a forge keystore) instead.
DEPLOYER_PRIVATE_KEY=

# --- Town Chest ------------------------------------------------------------------
# Multisig that owns the Town Chest after deploy (it calls acceptOwnership()).
# It sets the keeper, the locks, the split and the exclusions, can pause,
# and can propose a rescue that executes 48 hours later in public.
CHEST_ADMIN=
# The Agentcity server's Agent Job treasury: a hot key that triggers releases
# and can never take funds. Must differ from CHEST_ADMIN. Its private key is
# the app server's AGENTCITY_JOB_TREASURY_PK.
CHEST_KEEPER=
# The town's token, AGENT CITY (the app server's AGENTCITY_TOKEN_ADDRESS).
CHEST_TOKEN=
# How long each pot stays locked between releases, in hours (1 to 720).
CHEST_LOCK_HOURS=24
# More addresses that never receive a share, comma-separated: the Placement
# treasury, for one. The pool manager, Hookr's router, the Agent gate,
# Permit2, the dead address and the keeper are always excluded.
CHEST_EXCLUDED=
